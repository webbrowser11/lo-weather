{
  "functions": {
    "api/api.py": {
      "runtime": "@vercel/python"
    }
  },
  "routes": [
    {
      "src": "/site/(.*)",
      "dest": "/site/$1"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/api.py"
    }
  ]
}
